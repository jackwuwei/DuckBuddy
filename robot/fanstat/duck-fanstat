#!/usr/bin/env python3
"""duck-fanstat: read-only LAN view of fanctl for DuckBuddy.

GET /fan  ->  {"schema": "duckbuddy.fan/v1", "ok": true, "temp_c": 49.4,
               "fans": [{"id", "name", "pct", "rpm", "mode", "health"}]}

Only ever sends {"op":"status"} to fanctl's root-only unix socket, so nothing on
the LAN can change fan speed. fanctl measures RPM by busy-polling the tach line
for ~0.4 s per status call, so answers are cached and fanctl is asked at most
once per CACHE_S, and only while someone is looking.
"""
import json
import os
import socket
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

FAN_SOCK = os.environ.get("FANSTAT_FANCTL_SOCK", "/run/fanctl/fan.sock")
PORT = int(os.environ.get("FANSTAT_PORT", "8096"))
CACHE_S = 3.0
SCHEMA = "duckbuddy.fan/v1"

_lock = threading.Lock()
_cache: tuple[float, int, bytes] | None = None


def _fanctl_status() -> dict:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(3.0)
        s.connect(FAN_SOCK)
        s.sendall(b'{"op":"status"}\n')
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
    return json.loads(buf)


def _num(v):
    return v if isinstance(v, (int, float)) and not isinstance(v, bool) else None


def _snapshot() -> tuple[int, dict]:
    try:
        st = _fanctl_status()
    except (OSError, ValueError) as exc:
        return 503, {"schema": SCHEMA, "ok": False, "error": f"fanctl unavailable: {exc}"}
    if not st.get("ok"):
        return 503, {"schema": SCHEMA, "ok": False, "error": str(st.get("error") or "fanctl error")}
    fans = []
    for it in st.get("items") or []:
        fans.append({
            "id": str(it.get("id") or ""),
            "name": str(it.get("name") or it.get("id") or ""),
            "pct": _num(it.get("pct")),
            "rpm": _num(it.get("rpm")),
            "mode": str(it.get("control_mode") or st.get("mode") or ""),
            "health": str(it.get("health") or ""),
        })
    return 200, {"schema": SCHEMA, "ok": True, "temp_c": _num(st.get("temp")), "fans": fans}


def cached() -> tuple[int, bytes]:
    global _cache
    with _lock:
        now = time.monotonic()
        if _cache is None or now - _cache[0] >= CACHE_S:
            code, body = _snapshot()
            _cache = (now, code, json.dumps(body, ensure_ascii=False).encode())
        return _cache[1], _cache[2]


class Handler(BaseHTTPRequestHandler):
    server_version = "duck-fanstat/1"

    def do_GET(self):
        if self.path.split("?", 1)[0] != "/fan":
            self.send_error(404)
            return
        code, body = cached()
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, fmt, *args):
        pass


def main() -> int:
    if "--once" in sys.argv:
        code, body = cached()
        print(code, body.decode())
        return 0 if code == 200 else 1
    srv = ThreadingHTTPServer(("0.0.0.0", PORT), Handler)
    srv.daemon_threads = True
    srv.serve_forever()
    return 0


if __name__ == "__main__":
    sys.exit(main())
